local function switchPage(name)
    for k, b in pairs(navBtns) do
        local active = (k == name)
        b.BackgroundColor3 = active and THEMES[1].accent or Color3.fromRGB(30, 22, 45)
        b.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 170, 200)
    end
    for k, p in pairs(pages) do p.Visible = (k == name) end
end

