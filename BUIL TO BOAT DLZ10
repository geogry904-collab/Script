    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -90, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(230, 225, 245)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local toggleBg = Instance.new("Frame")
    toggleBg.Size = UDim2.new(0, 40, 0, 22)
    toggleBg.Position = UDim2.new(1, -54, 0.5, -11)
    toggleBg.BackgroundColor3 = Color3.fromRGB(60, 55, 80)
    toggleBg.BorderSizePixel = 0
    toggleBg.Parent = row
    local tbc = Instance.new("UICorner")
    tbc.CornerRadius = UDim.new(1, 0)
    tbc.Parent = toggleBg

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 16, 0, 16)
    dot.Position = UDim2.new(0, 3, 0.5, -8)
    dot.BackgroundColor3 = Color3.fromRGB(200, 200, 220)
    dot.BorderSizePixel = 0
    dot.Parent = toggleBg
    local dc = Instance.new("UICorner")
    dc.CornerRadius = UDim.new(1, 0)
    dc.Parent = dot

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row

    local on = S[key] or false
    local function update()
        if on then
            TweenService:Create(dot, TweenInfo.new(0.15),
                {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
            TweenService:Create(toggleBg, TweenInfo.new(0.15),
                {BackgroundColor3 = THEMES[1].accent}):Play()
        else
            TweenService:Create(dot, TweenInfo.new(0.15),
                {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
            TweenService:Create(toggleBg, TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(60, 55, 80)}):Play()
        end
    end
    update()

    btn.MouseButton1Click:Connect(function()
        on = not on
        S[key] = on
        update()
        pcall(callback, on)
    end)
    return row
end

local function makeSlider(parent, text, key, minV, maxV, defV, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 56)
    row.BackgroundColor3 = Color3.fromRGB(35, 28, 50)
    row.BorderSizePixel = 0
    row.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -80, 0, 20)
    lbl.Position = UDim2.new(0, 14, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(230, 225, 245)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 60, 0, 20)
    valLbl.Position = UDim2.new(1, -74, 0, 6)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(defV)
    valLbl.TextColor3 = THEMES[1].accent
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12
    valLbl.Parent = row

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -28, 0, 8)
    bar.Position = UDim2.new(0, 14, 0, 34)
    bar.BackgroundColor3 = Color3.fromRGB(60, 55, 80)
    bar.BorderSizePixel = 0
    bar.Parent = row
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(1, 0)
    bc.Parent = bar

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((defV - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = THEMES[1].accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local dragging = false
    local function setVal(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(minV + (maxV - minV) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valLbl.Text = tostring(v)
        S[key] = v
        pcall(callback, v)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setVal(input.Position.X)
        end
    end)
    bar.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setVal(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return row
end

