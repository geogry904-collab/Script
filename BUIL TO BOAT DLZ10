-- ==================== ФУНКЦИИ AUTOBUILD (Build a Boat) ====================
local function getLocalBoat()
    -- персонаж игрока — в BABFT персонаж сам является лодкой
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hrp
end

local function placeBlock(pos, size)
    -- Проверяем место, ставим блок локально (клиент может видеть только клиентские)
    -- В BABFT постройка происходит серверно, поэтому используем режим подсказки
    -- — но для авто-крафта проще «нажимать» кнопку постройки повторно.
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        -- Имитируем нажатие действия (зависит от текущего тула)
        pcall(function()
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Remote") then
                tool.Remote:FireServer("Build", pos)
            elseif tool then
                tool:Activate()
            end
        end)
    end
end

local function startAutoBuild()
    if buildConn then buildConn:Disconnect() end
    buildConn = RunService.Heartbeat:Connect(function()
        if not S.autoBuild then return end
        local hrp = getLocalBoat()
        if not hrp then return end
        -- простой цикл постройки — ставим блоки перед собой
        for i = 1, math.max(1, math.floor(S.buildBlocks / 10)) do
            local offset = Vector3.new(0, 0, -i * 3)
            local pos = (hrp.CFrame * CFrame.new(offset)).Position
            placeBlock(pos)
        end
    end)
end

-- ==================== ФУНКЦИИ AUTOFARM ====================
local function startAutoFarm()
    if farmConn then farmConn:Disconnect() end
    farmConn = RunService.Heartbeat:Connect(function()
        if not S.autoFarm then return end
        local hrp = getLocalBoat()
        if not hrp then return end
        -- телепорт к ближайшим монетам/сокровищам (ищем по имени)
        if S.farmMode == "Монеты" then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name:lower():find("coin") or obj.Name:lower():find("gold")) then
                    local d = (obj.Position - hrp.Position).Magnitude
                    if d < S.farmRadius and d > 3 then
                        hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 3, 0))
                        break
                    end
                end
            end
        elseif S.farmMode == "Сокровища" then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("treasure") then
                    local d = (obj.Position - hrp.Position).Magnitude
                    if d < S.farmRadius then
                        hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 3, 0))
                        break
                    end
                end
            end
        end
    end)
end

