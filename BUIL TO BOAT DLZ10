        {BackgroundColor3 = theme.bg:Lerp(Color3.fromRGB(255,255,255), 0.05)}):Play()
    TweenService:Create(brand, TweenInfo.new(0.3),
        {BackgroundColor3 = theme.bg:Lerp(Color3.fromRGB(255,255,255), 0.1)}):Play()
    TweenService:Create(logo, TweenInfo.new(0.3), {BackgroundColor3 = theme.accent}):Play()
    contentTitle.TextColor3 = theme.accent
    notify("Тема: " .. theme.name)
end

