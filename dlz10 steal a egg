-- ==================== ПЛАВНЫЙ ТЕЛЕПОРТ (TWEEN) ====================
-- Двигаем CFrame мелкими шагами — сервер видит движение, не прыжок.
local function smoothTravel(targetPos, duration)
    local hrp = getHRP()
    if not hrp then return false end
    if not duration or duration <= 0 then duration = 0.3 end
    local startCF = hrp.CFrame
    local targetCF = CFrame.new(targetPos)
    local t = 0
    local startTime = tick()
    while t < duration do
        t = tick() - startTime
        local alpha = math.min(t / duration, 1)
        -- ease out quad
        alpha = 1 - (1 - alpha) * (1 - alpha)
        hrp.CFrame = startCF:Lerp(targetCF, alpha)
        RunService.RenderStepped:Wait()
    end
    hrp.CFrame = targetCF
    return true
end

