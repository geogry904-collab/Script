local function findEggs()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = string.lower(obj.Name)
            if string.find(n, "egg") or string.find(n, "nest") then
                local pos
                if obj:IsA("Model") then
                    local pp = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    pos = pp and pp.Position
                else
                    pos = obj.Position
                end
                if pos then table.insert(list, {obj=obj, pos=pos, name=obj.Name}) end
            end
        end
    end
    return list
end

local function closestEgg()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bd = nil, S.teleportRange
    for _, e in ipairs(findEggs()) do
        local d = (e.pos - hrp.Position).Magnitude
        if d < bd then bd = d; best = e end
    end
    return best
end

local function pressStealButton()
    local pg2 = player:FindFirstChild("PlayerGui")
    if not pg2 then return false end
    for _, obj in ipairs(pg2:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local t = string.lower(obj.Text or "")
            local n = string.lower(obj.Name)
            if string.find(t, "steal") or string.find(n, "steal") then
                if obj.Visible and obj.Active then
                    pcall(function() firesignal(obj.MouseButton1Click) end)
                    pcall(function() firesignal(obj.Activated) end)
                    return true
                end
            end
        end
    end
    return false
end

local function pressNearestPrompt()
    local hrp = getHRP()
    if not hrp then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local par = obj.Parent
            if par and par:IsA("BasePart") then
                local d = (par.Position - hrp.Position).Magnitude
                if d < 15 then
                    pcall(function() fireproximityprompt(obj) end)
                end
            end
        end
    end
end

local function saveHome()
    local hrp = getHRP()
    if hrp then
        homeCFrame = hrp.CFrame
        currentStatus = "База запомнена"
        notify("База запомнена")
    end
end

local function goHome()
    local hrp = getHRP()
    if hrp and homeCFrame then
        smoothTravel(homeCFrame.Position, S.returnTime)
        currentStatus = "ТП на базу"
        notify("ТП на базу")
    else
        notify("База не запомнена")
    end
end

local function startAutoSteal()
    if stealConn then
        pcall(function() task.cancel(stealConn) end)
        stealConn = nil
    end
    stealConn = task.spawn(function()
        while S.autoSteal do
            local hrp = getHRP()
            if hrp then
                local egg = closestEgg()
                if egg then
                    currentStatus = "Летим к " .. egg.name
                    smoothTravel(egg.pos + Vector3.new(0, 2, 0), S.travelTime)
                    task.wait(S.stealWait)
                    currentStatus = "Жмём Steal"
                    if not pressStealButton() then
                        pressNearestPrompt()
                    end
                    task.wait(0.1)
                    if homeCFrame then
                        currentStatus = "Возврат на базу"
                        smoothTravel(homeCFrame.Position, S.returnTime)
                    end
                    task.wait(0.15)
                else
                    currentStatus = "Ищу яйцо..."
                    task.wait(0.5)
                end
            else
                task.wait(0.5)
            end
        end
        currentStatus = "Готов"
    end)
end

