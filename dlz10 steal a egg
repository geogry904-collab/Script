-- ==================== ОСНОВНОЙ ЦИКЛ ====================
RunService.RenderStepped:Connect(function()
    local ch = player.Character
    if not ch then return end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if S.fly and flyBV then
        local cam2 = workspace.CurrentCamera
        local move = Vector3.zero
        local md = hum.MoveDirection
        if md.Magnitude > 0 then move += cam2.CFrame:VectorToWorldSpace(md) end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then move = move.Unit end
        flyBV.Velocity = move * S.flySpeed
        flyBG.CFrame = cam2.CFrame
    end

    if S.speed then hum.WalkSpeed = S.speedValue end

    if S.noclip then
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    -- ESP
    if S.espPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local exists = false
                for _, o in pairs(espObjs) do
                    if o and o.Adornee == p.Character then exists = true; break end
                end
                if not exists then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = p.Character
                    hl.FillColor = S.accent
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = S.espOutline and 0 or 1
                    hl.DepthMode = S.espBoxes and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                    hl.Parent = p.Character
                    table.insert(espObjs, hl)
                end
            end
        end
    end

    if S.espEggs or S.espAnimals then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                local shouldEsp = (S.espEggs and n:find("egg")) or (S.espAnimals and (n:find("animal") or n:find("pet")))
                if shouldEsp then
                    local exists = false
                    for _, o in pairs(espObjs) do
                        if o and o.Adornee == obj then exists = true; break end
                    end
                    if not exists then
                        local bb = Instance.new("BillboardGui")
                        bb.Size = UDim2.new(0, 60, 0, 30)
                        bb.AlwaysOnTop = true
                        bb.Adornee = obj
                        bb.Parent = obj
                        local txt = Instance.new("TextLabel")
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Text = obj.Name
                        txt.TextColor3 = S.espEggs and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(255, 80, 80)
                        txt.TextStrokeTransparency = 0
                        txt.TextScaled = true
                        txt.Font = Enum.Font.GothamBold
                        txt.Parent = bb
                        table.insert(espObjs, bb)
                    end
                end
            end
        end
    end
end)

