-- ==================== AUTO STEAL ====================
makeSection(pageGroups.steal, "Автокража яиц")

makeToggle(pageGroups.steal, "Auto Steal", "autoSteal", function(on)
    S.autoSteal = on
    if stealConn then stealConn:Disconnect(); stealConn = nil end
    if on then
        stealConn = RunService.Heartbeat:Connect(function()
            if not S.autoSteal then return end
            local hrp = getHRP()
            if not hrp then return end
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
                    local d = (obj.Position - hrp.Position).Magnitude
                    if d < S.stealRange then
