local function switchPage(id)
    for k, b in pairs(navBtns) do
        local active = (k == id)
        b.BackgroundColor3 = active and S.accent or Color3.fromRGB(30, 22, 45)
        b.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 170, 200)
    end
    for k, p in pairs(pageGroups) do p.Visible = (k == id) end
    for _, def in ipairs(PAGES) do
        if def[1] == id then contentTitle.Text = def[2]; break end
    end
end

